{
  "name": "dsg-omnichannel.web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run clean:cache && ng serve",
    "start:fast": "ng serve",
    "build": "ng build",
    "build:clean": "npm run clean:cache && ng build",
    "watch": "ng build --watch --configuration development",
    "clean:cache": "node -e \"require('node:fs').rmSync('.angular/cache', { recursive: true, force: true })\"",
    "stop": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 4200 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force }\"",
    "test": "ng test",
    "serve:ssr:DsgOmnichannel.Web": "node dist/DsgOmnichannel.Web/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.8",
    "@microsoft/signalr": "^10.0.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
